{
  "name": "stackgenome-api",
  "version": "0.1.0",
  "private": true,
  "description": "StackGenome API backend — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "echo 'Remote migration requires explicit authorization. Run: wrangler d1 migrations apply stackgenome-catalog-staging --remote'",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20250906.0": true,
    "workerd@1.20260730.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true,
    "sharp@0.35.2": true,
    "fsevents@2.3.3": true
  }
}
